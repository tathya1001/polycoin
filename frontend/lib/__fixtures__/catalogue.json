    "median"
   ],
   "default_agg": "sum"
  },
  {
   "id": "amount",
   "aggs": [
    "sum",
    "avg",
    "min",
    "max",
    "median"
   ],
   "default_agg": "sum"
  },
  {
   "id": "count",
   "aggs": [
    "sum"
   ],
   "default_agg": "sum"
  },
  {
   "id": "balance",
   "aggs": [
    "last"
   ],
   "default_agg": "last"
  }
 ],
 "charts": {
  "kpi": {
   "x": [],
   "color": false
  },
  "bar": {
   "x": [
    "date",
    "weekday",
    "month_of_year",
    "category",
    "txn_type",
    "merchant"
   ],
   "color": true
  },
  "line": {
   "x": [
    "date"
   ],
   "color": true
  },
  "area": {
   "x": [
    "date"
   ],
   "color": true
  },
  "pie": {
   "x": [
    "weekday",
    "month_of_year",
    "category",
    "txn_type",
    "merchant"
   ],
   "color": false
  },
  "donut": {
   "x": [
    "weekday",
    "month_of_year",
    "category",
    "txn_type",
    "merchant"
   ],
   "color": false
  },
  "histogram": {
   "x": [],
   "color": false
  },
  "calendar": {
   "x": [],
   "color": false
  },
  "heatmap": {
   "x": [
    "date",
    "weekday",
    "month_of_year",
    "category",
    "txn_type",
    "merchant"
   ],
   "color": false
  },
  "text": {
   "x": [],
   "color": false
  }
 },
 "calcs": [
  {
   "id": "running_total",
   "needs_date": true,
   "additive_only": true,
   "never_negative": false
  },
  {
   "id": "percent_of_total",
   "needs_date": false,
   "additive_only": true,
   "never_negative": true
  },
  {
   "id": "moving_average",
   "needs_date": true,
   "additive_only": false,
   "never_negative": false
  },
  {
   "id": "change",
   "needs_date": true,
   "additive_only": false,
   "never_negative": false
  }
 ],
 "kpi": {
  "compares": [
   "none",
   "previous",
   "year_ago",
   "average"
  ],
  "directions": [
   "auto",
   "up_is_good",
   "down_is_good"
  ],
  "secondary": [
   {
    "id": "count",
    "needs_money_measure": false,
    "needs_sum": false
   },
   {
    "id": "average",
    "needs_money_measure": true,
    "needs_sum": false
   },
   {
    "id": "largest",
    "needs_money_measure": true,
    "needs_sum": false
   },
   {
    "id": "share_of_income",
    "needs_money_measure": true,
    "needs_sum": true
   }
  ],
  "money_measures": [
   "spend",
   "income",
   "net",
   "amount"
  ],
  "average_of": [
   3,
   12
  ],
  "max_secondary": 3
 },
 "format": {
  "numbers": [
   "auto",
   "full",
   "compact"
  ],
  "legends": [
   "auto",
   "top",
   "bottom",
   "right",
   "none"
  ],
  "charts": [
   "bar",
   "line",
   "area",
   "pie",
   "donut",
   "histogram",
   "calendar",
   "heatmap"
  ],
  "legend_charts": [
   "bar",
   "line",
   "area",
   "pie",
   "donut"
  ],
  "axis_charts": [
   "bar",
   "line",
   "area"
  ]
 },
 "rows_fields": [
  "weekday",
  "month_of_year",
  "category",
  "txn_type",
  "merchant"
 ],
 "formula": {
  "charts": [
   "bar",
   "line",
   "area",
   "kpi"
  ],
  "agg": "avg",
  "forms": [
   "number",
   "percent",
   "money"
  ],
  "max_length": 500,
  "variables": [
   {
    "name": "spend",
    "help": "The group's total spend: SUM([Spend])."
   },
   {
    "name": "income",
    "help": "The group's total income: SUM([Income])."
   },
   {
    "name": "net",
    "help": "Income minus spend: SUM([Net])."
   },
   {
    "name": "count",
    "help": "The number of transactions: COUNT([Amount])."
   },
   {
    "name": "days",
    "help": "The number of calendar days the group covers."
   }
  ],
  "fields": [
   {
    "name": "Amount",
    "type": "number",
    "help": "The amount, always positive."
   },
   {
    "name": "Spend",
    "type": "number",
    "help": "The amount of a debit. Missing for a credit."
   },
   {
    "name": "Income",
    "type": "number",
    "help": "The amount of a credit. Missing for a debit."
   },
   {
    "name": "Net",
    "type": "number",
    "help": "The amount, negative for a debit."
   },
   {
    "name": "Type",
    "type": "text",
    "help": "\"debit\" or \"credit\"."
   },
   {
    "name": "Category",
    "type": "text",
    "help": "The category's name."
   },
   {
    "name": "Merchant",
    "type": "text",
    "help": "The merchant, written as the charts group it."
   },
   {
    "name": "Date",
    "type": "date",
    "help": "The day of the transaction."
   },
   {
    "name": "Balance",
    "type": "number",
    "help": "The balance after the transaction. Missing if the statement had none."
   }
  ],
  "functions": [
   {
    "name": "SUM",
    "signature": "SUM(x)",
    "group": "aggregate",
    "help": "Adds up x over the group's transactions."
   },
   {
    "name": "AVG",
    "signature": "AVG(x)",
    "group": "aggregate",
    "help": "The average of x."
   },
   {
    "name": "MEDIAN",
    "signature": "MEDIAN(x)",
    "group": "aggregate",
    "help": "The middle value of x."
   },
   {
    "name": "MIN",
    "signature": "MIN(x)",
    "group": "aggregate",
    "help": "The smallest x. MIN(a, b, \u2026) is the smallest of its values."
   },
   {
    "name": "MAX",
    "signature": "MAX(x)",
    "group": "aggregate",
    "help": "The largest x. MAX(a, b, \u2026) is the largest of its values."
   },
   {
    "name": "COUNT",
    "signature": "COUNT(x)",
    "group": "aggregate",
    "help": "How many transactions have a value for x."
   },
   {
    "name": "COUNTD",
    "signature": "COUNTD(x)",
    "group": "aggregate",
    "help": "How many different values x has."
   },
   {
    "name": "IIF",
    "signature": "IIF(test, then, else)",
    "group": "logic",
    "help": "then if the test is true, otherwise else."
   },
   {
    "name": "ZN",
    "signature": "ZN(x)",
    "group": "logic",
    "help": "x, or 0 if x is missing."
   },
   {
    "name": "IFNULL",
    "signature": "IFNULL(x, other)",
    "group": "logic",
    "help": "x, or other if x is missing."
   },
   {
    "name": "COALESCE",
    "signature": "COALESCE(a, b, \u2026)",
    "group": "logic",
    "help": "The first value that is not missing."
   },
   {
    "name": "NULLIF",
    "signature": "NULLIF(a, b)",
    "group": "logic",
    "help": "Missing if a equals b, otherwise a."
   },
   {
    "name": "ISNULL",
    "signature": "ISNULL(x)",
    "group": "logic",
    "help": "True if x is missing."
   },
   {
    "name": "ABS",
    "signature": "ABS(x)",
    "group": "number",
    "help": "x without its minus sign."
   },
   {
    "name": "ROUND",
    "signature": "ROUND(x, places)",
    "group": "number",
    "help": "x rounded half up, to 0 to 6 decimal places."
   },
   {
    "name": "FLOOR",
    "signature": "FLOOR(x)",
    "group": "number",
    "help": "x rounded down to a whole number."
   },
   {
    "name": "CEILING",
    "signature": "CEILING(x)",
    "group": "number",
    "help": "x rounded up to a whole number. CEIL works too."
   },
   {
    "name": "CEIL",
    "signature": "CEIL(x)",
    "group": "number",
    "help": "The same as CEILING(x)."
   },
   {
    "name": "POWER",
    "signature": "POWER(x, y)",
    "group": "number",
    "help": "x to the power y (y from -100 to 100)."
   },
   {
    "name": "SQRT",
    "signature": "SQRT(x)",
    "group": "number",
    "help": "The square root of x. Missing if x is negative."
   },
   {
    "name": "SIGN",
    "signature": "SIGN(x)",
    "group": "number",
    "help": "-1, 0 or 1."
   },
   {
    "name": "CONTAINS",
    "signature": "CONTAINS(text, part)",
    "group": "text",
    "help": "True if the text holds the part. Ignores case."
   },
   {
    "name": "STARTSWITH",
    "signature": "STARTSWITH(text, part)",
    "group": "text",
    "help": "True if the text starts with the part."
   },
   {
    "name": "ENDSWITH",
    "signature": "ENDSWITH(text, part)",
    "group": "text",
    "help": "True if the text ends with the part."
   },
   {
    "name": "DATE",
    "signature": "DATE(\"YYYY-MM-DD\")",
    "group": "date",
    "help": "A fixed date, to compare [Date] with."
   },
   {
    "name": "YEAR",
    "signature": "YEAR(date)",
    "group": "date",
    "help": "The year, such as 2026."
   },
   {
    "name": "QUARTER",
    "signature": "QUARTER(date)",
    "group": "date",
    "help": "1 to 4."
   },
   {
    "name": "MONTH",
    "signature": "MONTH(date)",
    "group": "date",
    "help": "1 to 12."
   },
   {
    "name": "DAY",
    "signature": "DAY(date)",
    "group": "date",
    "help": "The day of the month, 1 to 31."
   },
   {
    "name": "WEEKDAY",
    "signature": "WEEKDAY(date)",
    "group": "date",
    "help": "1 = Monday \u2026 7 = Sunday."
   },
   {
    "name": "DATEPART",
    "signature": "DATEPART('part', date)",
    "group": "date",
    "help": "The 'year', 'quarter', 'month', 'day' or 'weekday' of a date."
   }
  ],
  "keywords": [
   "IF",
   "THEN",
   "ELSEIF",
   "ELSE",
   "END",
   "CASE",
   "WHEN",
   "AND",
   "OR",
   "NOT",
   "IN",
   "TRUE",
   "FALSE",
   "NULL"
  ]
 },
 "parameters": {
  "defaults": {
   "top_n": 10,
   "granularity": "month",
   "measure": "spend",
