# Copy to .env and replace every placeholder. Never commit .env.
# Generation commands run inside the container, e.g.:
#   docker compose run --rm backend python -c "<command>"

POSTGRES_DB=moneyangle
POSTGRES_USER=moneyangle
POSTGRES_PASSWORD=change-me
# Must use the same user, password and database name as the POSTGRES_* values above.
DATABASE_URL=postgres://moneyangle:change-me@db:5432/moneyangle

# generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
# Development only. Anything other than TRUE turns debug off.
DJANGO_DEBUG=TRUE
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3001

# Signs JWTs. Must differ from DJANGO_SECRET_KEY.
# generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=change-me
# FALSE only for local http development; TRUE in production (https).
AUTH_COOKIE_SECURE=FALSE

# No master key. Since Phase 12.1 each user's data key is locked with their password and a
# recovery key, so a new setup needs nothing here. A database from before Phase 12.1 needs its
# old key (format v1:base64) until every account has logged in once, and then never again:
# FIELD_ENCRYPTION_KEYS=v1:...

# AI categorisation. Your browser calls the Ollama on your own machine (http://localhost:11434)
# and you pick one of your installed embedding models in the UI; the backend never calls Ollama
# and needs no Ollama settings. Nothing is bundled or downloaded by this app, and no data leaves
# your machine. For a deployed site, each user allows its origin in OLLAMA_ORIGINS (the
# Categorize page shows how). Optional tuning; the defaults below apply when unset:
# AI_MAX_RUN=200  AI_MAX_EXAMPLES_PER_CATEGORY=20  AI_MIN_SCORE=0.45
#         AI_MIN_MARGIN=0.05  AI_BLEND_FULL_AT=10  AI_BLEND_MAX_WEIGHT=0.7

# --- Production only (set in Render's and Vercel's dashboards, never in this file) ---
# DJANGO_PRODUCTION=TRUE  AUTH_COOKIE_SECURE=TRUE  (leave DJANGO_DEBUG unset)
# SECURE_HSTS_SECONDS=3600   (raise to 31536000 once everything works)
# WEB_CONCURRENCY=2  INSIGHTS_MAX_ROWS=20000
# SENTRY_DSN=               error tracking; sends no cookies, IPs, bodies or local variables
# ORIGIN_SECRET=            same value on Render (Django) and Vercel (the /api proxy).
#                           Set it on Vercel first, then on Render.
# generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
