{
	admin off
	auto_https off
}

:8080 {
	route {
		# A missing, empty or short token must never let anything through: with an empty
		# OLLAMA_GATEWAY_TOKEN the exact match below would accept "Authorization: Bearer ".
		@weak_config not header_regexp token Authorization ^Bearer\s.{32,}$
		respond @weak_config 401

		@unauthorized not header Authorization "Bearer {$OLLAMA_GATEWAY_TOKEN}"
		respond @unauthorized 401

		request_body {
			max_size 2MB
		}

		@allowed expression `(method('POST') && path('/api/embed')) || (method('GET') && path('/api/tags'))`
		reverse_proxy @allowed host.docker.internal:11434 {
			header_up Host localhost:11434
		}

		respond 404
	}
}
